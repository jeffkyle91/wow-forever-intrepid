# Local emulator mode (npm run dev:emulator). Fake values only: a demo- project never contacts Google.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-intrepid.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-intrepid
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_GUILD_ID=guild-local
VITE_USE_EMULATORS=true
