{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs24",
    "ignore": ["node_modules", ".git", "*.test.js", "*.log"]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 19099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 18080
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 15001
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 19199
    },
    "ui": {
      "enabled": false
    }
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
